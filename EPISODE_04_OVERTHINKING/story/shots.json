   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s076",
   "start": 268.084,
   "end": 271.545,
   "line": "The cost is not dramatic. It is quiet.",
   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s077",
   "start": 271.545,
   "end": 277.939,
   "line": "It is a hundred small withdrawals of attention from the life in front of you.",
   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s078",
   "start": 277.939,
   "end": 282.979,
