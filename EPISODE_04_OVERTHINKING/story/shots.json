   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s082",
   "start": 294.263,
   "end": 296.55,
   "line": "Repetition feels productive.",
   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
