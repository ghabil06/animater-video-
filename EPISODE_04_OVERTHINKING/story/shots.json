  {
   "id": "s072",
   "start": 246.494,
   "end": 252.888,
   "line": "Concentration slips, because part of your attention is always somewhere else.",
   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s073",
   "start": 252.888,
   "end": 259.584,
   "line": "Conversations get harder, because you are partly listening, and partly reviewing.",
   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s074",
   "start": 259.584,
   "end": 261.488,
   "line": "And decisions slow down,",
   "scene": "TODO",
   "set": null,
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": ""
  },
  {
   "id": "s075",
   "start": 261.488,
   "end": 268.084,
